{
  "mailer_subjects_confirmation": "Confirm your email to join SPLIT",
  "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"color-scheme\" content=\"light\">\n    <meta name=\"supported-color-schemes\" content=\"light\">\n    <title>Confirm your email to join SPLIT</title>\n    <style>\n      body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\n      table, td { mso-table-lspace:0; mso-table-rspace:0; }\n      img { -ms-interpolation-mode:bicubic; }\n      a:focus-visible { outline:3px solid #0c2642; outline-offset:4px; }\n      @media only screen and (max-width:600px) {\n        .outer { padding:16px 12px !important; }\n        .content { padding:28px 24px !important; }\n        .email-heading { font-size:26px !important; line-height:34px !important; }\n      }\n    </style>\n  </head>\n  <body style=\"margin:0;padding:0;width:100%;background-color:#f4f6f8;color:#0c2642;font-family:Arial,Helvetica,sans-serif;letter-spacing:0;\">\n    <div style=\"display:none;font-size:1px;line-height:1px;color:#f4f6f8;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">One quick confirmation. Then your next collaboration starts here.</div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f4f6f8;\">\n      <tr>\n        <td class=\"outer\" align=\"center\" style=\"padding:40px 16px;\">\n          <!--[if mso]><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><![endif]-->\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background-color:#ffffff;border:1px solid #dce2ea;border-radius:8px;\">\n            <tr>\n              <td class=\"content\" style=\"padding:32px 36px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td width=\"52\" style=\"width:52px;vertical-align:middle;\">\n                      <img src=\"https://www.mysplit.co/split-android-chrome-512x512.png\" width=\"44\" height=\"44\" alt=\"SPLIT elephant\" style=\"display:block;width:44px;height:44px;border:0;border-radius:6px;\">\n                    </td>\n                    <td style=\"vertical-align:middle;font-size:26px;line-height:32px;font-weight:800;color:#0c2642;\">SPLIT</td>\n                  </tr>\n                </table>\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr><td style=\"padding-top:28px;border-bottom:1px solid #dce2ea;font-size:1px;line-height:1px;\">&nbsp;</td></tr>\n                  <tr><td style=\"padding-top:28px;\">\n                    <h1 class=\"email-heading\" style=\"margin:0 0 16px;font-size:30px;line-height:38px;font-weight:700;color:#0c2642;\">Welcome to SPLIT.</h1>\n                    <p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#5a6c84;\">Confirm your email to start creating split sheets and collaborating on your music.</p>\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr><td align=\"center\" bgcolor=\"#f8a50e\" style=\"background-color:#f8a50e;border-radius:6px;\">\n                        <a data-auth-action=\"primary\" href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:solid #f8a50e;border-width:14px 24px;border-radius:6px;background-color:#f8a50e;color:#0c2642;font-size:16px;line-height:22px;font-weight:700;text-align:center;text-decoration:none;mso-line-height-rule:exactly;\">Confirm email</a>\n                      </td></tr>\n                    </table>\n                    <p style=\"margin:20px 0 0;font-size:13px;line-height:21px;color:#5a6c84;\">Button not working? <a data-auth-action=\"fallback\" href=\"{{ .ConfirmationURL }}\" style=\"color:#0c2642;text-decoration:underline;\">Open the secure link</a>.</p>\n                  </td></tr>\n                  <tr><td style=\"padding-top:28px;border-bottom:1px solid #dce2ea;font-size:1px;line-height:1px;\">&nbsp;</td></tr>\n                  <tr><td style=\"padding-top:20px;\">\n                    <p style=\"margin:0;font-size:13px;line-height:21px;color:#5a6c84;\">If you didn&#39;t create a SPLIT account, you can ignore this email.</p>\n                  </td></tr>\n                </table>\n              </td>\n            </tr>\n          </table>\n          <!--[if mso]></td></tr></table><![endif]-->\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;\">\n            <tr><td align=\"center\" style=\"padding:20px 16px;\">\n              <p style=\"margin:0 0 8px;font-size:13px;line-height:20px;color:#5a6c84;\">Your music. Your collaborators. Your SPLIT.</p>\n              <p style=\"margin:0;font-size:12px;line-height:20px;color:#5a6c84;\"><a href=\"https://www.mysplit.co/\" style=\"color:#5a6c84;text-decoration:underline;\">mysplit.co</a> &nbsp;&middot;&nbsp; <a href=\"mailto:xtiancarrera@gmail.com\" style=\"color:#5a6c84;text-decoration:underline;\">Contact SPLIT</a></p>\n            </td></tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_recovery": "Reset your SPLIT password",
  "mailer_templates_recovery_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"color-scheme\" content=\"light\">\n    <meta name=\"supported-color-schemes\" content=\"light\">\n    <title>Reset your SPLIT password</title>\n    <style>\n      body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\n      table, td { mso-table-lspace:0; mso-table-rspace:0; }\n      img { -ms-interpolation-mode:bicubic; }\n      a:focus-visible { outline:3px solid #0c2642; outline-offset:4px; }\n      @media only screen and (max-width:600px) {\n        .outer { padding:16px 12px !important; }\n        .content { padding:28px 24px !important; }\n        .email-heading { font-size:26px !important; line-height:34px !important; }\n      }\n    </style>\n  </head>\n  <body style=\"margin:0;padding:0;width:100%;background-color:#f4f6f8;color:#0c2642;font-family:Arial,Helvetica,sans-serif;letter-spacing:0;\">\n    <div style=\"display:none;font-size:1px;line-height:1px;color:#f4f6f8;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">A secure link to choose a new password for your SPLIT account.</div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f4f6f8;\">\n      <tr>\n        <td class=\"outer\" align=\"center\" style=\"padding:40px 16px;\">\n          <!--[if mso]><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><![endif]-->\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background-color:#ffffff;border:1px solid #dce2ea;border-radius:8px;\">\n            <tr>\n              <td class=\"content\" style=\"padding:32px 36px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td width=\"52\" style=\"width:52px;vertical-align:middle;\">\n                      <img src=\"https://www.mysplit.co/split-android-chrome-512x512.png\" width=\"44\" height=\"44\" alt=\"SPLIT elephant\" style=\"display:block;width:44px;height:44px;border:0;border-radius:6px;\">\n                    </td>\n                    <td style=\"vertical-align:middle;font-size:26px;line-height:32px;font-weight:800;color:#0c2642;\">SPLIT</td>\n                  </tr>\n                </table>\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr><td style=\"padding-top:28px;border-bottom:1px solid #dce2ea;font-size:1px;line-height:1px;\">&nbsp;</td></tr>\n                  <tr><td style=\"padding-top:28px;\">\n                    <h1 class=\"email-heading\" style=\"margin:0 0 16px;font-size:30px;line-height:38px;font-weight:700;color:#0c2642;\">Back to your music.</h1>\n                    <p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#5a6c84;\">We received a request to reset your SPLIT password. Choose a new one to get back to your account.</p>\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr><td align=\"center\" bgcolor=\"#f8a50e\" style=\"background-color:#f8a50e;border-radius:6px;\">\n                        <a data-auth-action=\"primary\" href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:solid #f8a50e;border-width:14px 24px;border-radius:6px;background-color:#f8a50e;color:#0c2642;font-size:16px;line-height:22px;font-weight:700;text-align:center;text-decoration:none;mso-line-height-rule:exactly;\">Reset password</a>\n                      </td></tr>\n                    </table>\n                    <p style=\"margin:20px 0 0;font-size:13px;line-height:21px;color:#5a6c84;\">Button not working? <a data-auth-action=\"fallback\" href=\"{{ .ConfirmationURL }}\" style=\"color:#0c2642;text-decoration:underline;\">Open the secure link</a>.</p>\n                  </td></tr>\n                  <tr><td style=\"padding-top:28px;border-bottom:1px solid #dce2ea;font-size:1px;line-height:1px;\">&nbsp;</td></tr>\n                  <tr><td style=\"padding-top:20px;\">\n                    <p style=\"margin:0;font-size:13px;line-height:21px;color:#5a6c84;\">Didn&#39;t request this? You can ignore this email. Your password won&#39;t change unless you complete the reset.</p>\n                  </td></tr>\n                </table>\n              </td>\n            </tr>\n          </table>\n          <!--[if mso]></td></tr></table><![endif]-->\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;\">\n            <tr><td align=\"center\" style=\"padding:20px 16px;\">\n              <p style=\"margin:0 0 8px;font-size:13px;line-height:20px;color:#5a6c84;\">Your music. Your collaborators. Your SPLIT.</p>\n              <p style=\"margin:0;font-size:12px;line-height:20px;color:#5a6c84;\"><a href=\"https://www.mysplit.co/\" style=\"color:#5a6c84;text-decoration:underline;\">mysplit.co</a> &nbsp;&middot;&nbsp; <a href=\"mailto:xtiancarrera@gmail.com\" style=\"color:#5a6c84;text-decoration:underline;\">Contact SPLIT</a></p>\n            </td></tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_email_change": "Confirm your SPLIT email change",
  "mailer_templates_email_change_content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"color-scheme\" content=\"light\">\n    <meta name=\"supported-color-schemes\" content=\"light\">\n    <title>Confirm your SPLIT email change</title>\n    <style>\n      body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\n      table, td { mso-table-lspace:0; mso-table-rspace:0; }\n      img { -ms-interpolation-mode:bicubic; }\n      a:focus-visible { outline:3px solid #0c2642; outline-offset:4px; }\n      @media only screen and (max-width:600px) {\n        .outer { padding:16px 12px !important; }\n        .content { padding:28px 24px !important; }\n        .email-heading { font-size:26px !important; line-height:34px !important; }\n      }\n    </style>\n  </head>\n  <body style=\"margin:0;padding:0;width:100%;background-color:#f4f6f8;color:#0c2642;font-family:Arial,Helvetica,sans-serif;letter-spacing:0;\">\n    <div style=\"display:none;font-size:1px;line-height:1px;color:#f4f6f8;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Confirm the change to your sign-in email. Your split sheets stay with you.</div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f4f6f8;\">\n      <tr>\n        <td class=\"outer\" align=\"center\" style=\"padding:40px 16px;\">\n          <!--[if mso]><table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><![endif]-->\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background-color:#ffffff;border:1px solid #dce2ea;border-radius:8px;\">\n            <tr>\n              <td class=\"content\" style=\"padding:32px 36px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td width=\"52\" style=\"width:52px;vertical-align:middle;\">\n                      <img src=\"https://www.mysplit.co/split-android-chrome-512x512.png\" width=\"44\" height=\"44\" alt=\"SPLIT elephant\" style=\"display:block;width:44px;height:44px;border:0;border-radius:6px;\">\n                    </td>\n                    <td style=\"vertical-align:middle;font-size:26px;line-height:32px;font-weight:800;color:#0c2642;\">SPLIT</td>\n                  </tr>\n                </table>\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr><td style=\"padding-top:28px;border-bottom:1px solid #dce2ea;font-size:1px;line-height:1px;\">&nbsp;</td></tr>\n                  <tr><td style=\"padding-top:28px;\">\n                    <h1 class=\"email-heading\" style=\"margin:0 0 16px;font-size:30px;line-height:38px;font-weight:700;color:#0c2642;\">A new email. Same SPLIT.</h1>\n                    <p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#5a6c84;\">Confirm the requested change to your SPLIT sign-in email.</p>\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 20px;table-layout:fixed;\">\n                    <tr><td style=\"padding:16px;background-color:#f4f6f8;border-left:3px solid #f8a50e;\">\n                      <p style=\"margin:0 0 5px;font-size:12px;line-height:18px;color:#5a6c84;\">New sign-in email</p>\n                      <p style=\"margin:0;font-size:15px;line-height:24px;font-weight:700;overflow-wrap:anywhere;word-break:break-all;\">{{ .NewEmail }}</p>\n                    </td></tr>\n                  </table>\n                  <p style=\"margin:0 0 24px;font-size:15px;line-height:24px;color:#5a6c84;\">For your security, confirm the change from both your current and new email inboxes. Your split sheets stay with your account.</p>\n                    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr><td align=\"center\" bgcolor=\"#f8a50e\" style=\"background-color:#f8a50e;border-radius:6px;\">\n                        <a data-auth-action=\"primary\" href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:solid #f8a50e;border-width:14px 24px;border-radius:6px;background-color:#f8a50e;color:#0c2642;font-size:16px;line-height:22px;font-weight:700;text-align:center;text-decoration:none;mso-line-height-rule:exactly;\">Confirm email change</a>\n                      </td></tr>\n                    </table>\n                    <p style=\"margin:20px 0 0;font-size:13px;line-height:21px;color:#5a6c84;\">Button not working? <a data-auth-action=\"fallback\" href=\"{{ .ConfirmationURL }}\" style=\"color:#0c2642;text-decoration:underline;\">Open the secure link</a>.</p>\n                  </td></tr>\n                  <tr><td style=\"padding-top:28px;border-bottom:1px solid #dce2ea;font-size:1px;line-height:1px;\">&nbsp;</td></tr>\n                  <tr><td style=\"padding-top:20px;\">\n                    <p style=\"margin:0;font-size:13px;line-height:21px;color:#5a6c84;\">Didn&#39;t request this change? Don&#39;t confirm it. Contact SPLIT support using the link below.</p>\n                  </td></tr>\n                </table>\n              </td>\n            </tr>\n          </table>\n          <!--[if mso]></td></tr></table><![endif]-->\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;\">\n            <tr><td align=\"center\" style=\"padding:20px 16px;\">\n              <p style=\"margin:0 0 8px;font-size:13px;line-height:20px;color:#5a6c84;\">Your music. Your collaborators. Your SPLIT.</p>\n              <p style=\"margin:0;font-size:12px;line-height:20px;color:#5a6c84;\"><a href=\"https://www.mysplit.co/\" style=\"color:#5a6c84;text-decoration:underline;\">mysplit.co</a> &nbsp;&middot;&nbsp; <a href=\"mailto:xtiancarrera@gmail.com\" style=\"color:#5a6c84;text-decoration:underline;\">Contact SPLIT</a></p>\n            </td></tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n"
}
