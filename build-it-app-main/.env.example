# Public build-time settings. Never use service-role or sb_secret_ keys here.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Deployed HTTPS origin, also allowlisted in Supabase Auth.
# Blank uses the deployed origin; local development has a production-origin fallback.
VITE_SUPABASE_AUTH_REDIRECT_URL=
VITE_GOOGLE_MAPS_API_KEY=

# Optional Sentry error reports. Off until a project is connected and explicitly enabled.
# Public project DSN only; never put a Sentry API/auth token in a VITE_ variable.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
# Set separately per deployment: production, preview, or development.
VITE_SENTRY_ENVIRONMENT=

# Server-only Apple Music catalog search. Never prefix these with VITE_.
# Set locally in .env.local and in Vercel environment variables before deploying.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Complete MusicKit .p8 contents, including BEGIN/END lines; see docs/apple-music-setup.md.
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us
