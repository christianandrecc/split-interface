# Public build-time settings only. Never use service-role or sb_secret_ keys.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Deployed HTTPS origin, also allowlisted in Supabase Auth.
# Blank uses the deployed origin; local development has a production-origin fallback.
VITE_SUPABASE_AUTH_REDIRECT_URL=
VITE_GOOGLE_MAPS_API_KEY=

# Optional Sentry error reports. Off until a project is connected and explicitly enabled.
# Public project DSN only; never put a Sentry API/auth token in a VITE_ variable.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
# Set separately per deployment: production, preview, or development.
VITE_SENTRY_ENVIRONMENT=
